    "provisional_external_datasets_forbidden": true,
    "real_case_requirement": "Development-contaminated dataset plus stable record_ref and fixture_path.",
    "failure_action": "Block merge until the known regression is understood or the expectation is deliberately versioned."
  },
  "cases": [
    {
      "case_id": "BBB_PREEXCITATION_WARNING_001",
      "description": "Independently fused complete BBB must not be silently deleted merely because preexcitation also publishes; preserve both with explicit confounding warning.",
      "case_type": "SYNTHETIC_SCENARIO",
      "scenario": "BBB_PREEXCITATION_WARNING",
      "source": {
        "dataset_id": "synthetic",
        "usage_role": "DEVELOPMENT_REGRESSION_ONLY"
      },
      "expected": {
        "final_codes_all": [
          "RBBB_MORPHOLOGY_COMPATIBLE",
          "VENTRICULAR_PREEXCITATION_COMPATIBLE"
        ],
        "warning_codes_all": [
          "PREEXCITATION_CONFOUNDS_BUNDLE_BRANCH_PATTERN"
        ],
        "final_finding_checks": [
          {
            "code": "RBBB_MORPHOLOGY_COMPATIBLE",
            "equals": {
              "confounded_by_preexcitation": true
            },
            "contains": {
              "basis": [
                "PREEXCITATION_CONFOUNDING_WARNING"
              ]
            }
          }
        ]
      }
    },
    {
      "case_id": "AV_FAST_TWO_TO_ONE_MAPPING_001",
