{
  "version": "MEDCALC_ECG_REGRESSION_CORPUS_V1",
  "role": "DEVELOPMENT_REGRESSION_ONLY",
  "report_as_validation": false,
  "policy": {
    "purpose": "Replay previously understood engineering failures after each ECG change.",
