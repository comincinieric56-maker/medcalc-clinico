          "av_conduction.conducted_p_n": 3,
          "av_conduction.nonconducted_p_n": 3,
          "av_conduction.p_qrs_coupling_fraction": 0.5
        }
      }
    },
    {
      "case_id": "RBBB_MULTILEAD_QRS_RESCUE_001",
